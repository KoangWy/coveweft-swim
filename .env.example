# Application
# Public base URL of the running app. Used for absolute links and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Browser-facing URL and publishable key. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Copy the publishable key printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side URL. Keep the local URL when the app runs on the host. The demo
# scripts override it for the app container with the API gateway on the
# Supabase Docker network (http://supabase_kong_coveweft-swim:8000).
SUPABASE_URL_INTERNAL=http://127.0.0.1:54321

# Secret key for the admin client, provisioning scripts, and server-only jobs.
# Copy the secret key printed by `supabase status`. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# AI provider (primary and fallback use the same OpenAI-compatible contract)
# Without AI_PRIMARY_API_KEY the app starts and the assistant reports that it is
# not configured. An empty *_REASONING_EFFORT means the parameter is not sent.
AI_PRIMARY_BASE_URL=https://api.mistral.ai/v1
AI_PRIMARY_MODEL=deepseek-v4-1-flash-1017
AI_PRIMARY_API_KEY=
AI_PRIMARY_REASONING_EFFORT=low
AI_FALLBACK_BASE_URL=https://api.mistral.ai/v1
AI_FALLBACK_MODEL=mistral-small-2603
AI_FALLBACK_API_KEY=
AI_FALLBACK_REASONING_EFFORT=
# Abort a request after this many milliseconds without data.
AI_TIMEOUT_MS=30000
# Completion budget per request, with room for reasoning tokens.
AI_MAX_TOKENS=4096

# AI quotas
AI_QUOTA_PER_USER_PER_DAY=30
AI_QUOTA_PER_USER_PER_MINUTE=5
AI_QUOTA_GLOBAL_PER_DAY=500

# Media package. The demo scripts download the release archive for
# MEDIA_VERSION, check it against MEDIA_ARCHIVE_SHA256, and serve the extracted
# files from the app at /media. On a cloud deployment, point MEDIA_BASE_URL at
# the bucket or CDN that holds the same files.
MEDIA_VERSION=studio-v1
MEDIA_BASE_URL=http://localhost:3000/media
MEDIA_ARCHIVE_SHA256=dec69ff80d043268e38f29739a27b244485f018d6a023290a83a92567c2b92d7

# Demo accounts created by `pnpm provision:demo`. These are local defaults; set
# different values for a cloud project and never commit cloud passwords.
DEMO_CUSTOMER_EMAIL=customer@demo.coveweft.local
DEMO_CUSTOMER_PASSWORD=demo-customer-123
DEMO_CUSTOMER_NAME=Demo Customer
DEMO_ADMIN_EMAIL=admin@demo.coveweft.local
DEMO_ADMIN_PASSWORD=demo-admin-123
DEMO_ADMIN_NAME=Demo Admin
# Privacy policy version stored as consent evidence for the demo accounts.
DEMO_POLICY_VERSION=2026-11-06

# GitHub token used only while the repository is private and the media archive
# is downloaded from a GitHub Release. Read access to the repository is enough.
GITHUB_TOKEN=
